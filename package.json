{
  "name": "proof-of-edge",
  "private": true,
  "workspaces": [
    "services"
  ],
  "scripts": {
    "abi": "npm run abi -w services",
    "smoke": "npm run smoke -w services",
    "typecheck": "npm run typecheck -w services",
    "marketplace": "npm run marketplace -w services",
    "paid-swap": "npm run paid-swap -w services",
    "sandbox-order": "npm run sandbox-order -w services",
    "settle": "npm run settle -w services --",
    "agent": "npm run agent -w services --",
    "collect": "npm run collect -w services --",
    "test": "npm run test -w services",
    "stream:create": "npm run stream:create -w services",
    "erc8004:register": "npm run erc8004:register -w services",
    "video:voices": "cd video && node --env-file=../.env.local voices.mjs",
    "video:narrate": "cd video && node --env-file=../.env.local narrate.mjs",
    "video:record": "cd video && node record.mjs",
    "video:build": "cd video && node assemble.mjs",
    "video:thumbnail": "cd video && node thumbnail.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.75.0",
    "playwright-core": "1.64.1"
  }
}
